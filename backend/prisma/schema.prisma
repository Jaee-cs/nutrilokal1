// Skema database NutriLokal Smart Production & Traceability Kit V1.0.
//
// Tugas B1 menyiapkan fondasi koneksi. Tugas B2 menambahkan model
// pengguna untuk autentikasi dan hak akses. Tugas B3 menambahkan
// master produk dan master bahan baku. Tugas B4 menambahkan stok
// bahan baku, penerimaan, saldo awal, dan jejak pergerakan stok.
// Tugas B5 menambahkan produksi, kode batch, pemakaian bahan aktual,
// dan koreksi catatan produksi. Model lainnya (penyesuaian stok,
// penjualan, QR, dll.) ditambahkan pada tugas roadmap berikutnya
// sesuai README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Peran pengguna internal. Hak akses selalu diperiksa di backend.
enum Role {
  ADMIN
  OPERATOR
}

/// Akun pengguna internal. Tidak ada pendaftaran publik;
/// akun Admin pertama dibuat melalui skrip bootstrap (npm run admin:create).
model User {
  id                String    @id @default(cuid())
  username          String    @unique
  /// Nama tampilan, boleh kosong.
  name              String?
  /// Kata sandi selalu disimpan sebagai hash (bcrypt), bukan teks biasa.
  passwordHash      String
  role              Role
  /// Akun dinonaktifkan tidak bisa login dan token lama ditolak.
  isActive          Boolean   @default(true)
  /// Setelah Admin mereset kata sandi, pengguna wajib menetapkan
  /// kata sandi baru sebelum bisa menggunakan sistem kembali.
  mustChangePassword Boolean  @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  materialReceipts        MaterialReceipt[]
  materialOpeningBalances MaterialOpeningBalance[]
  materialStockMovements  MaterialStockMovement[]
  productions             Production[]
  productionCorrections   ProductionCorrection[]
  batchStockMovements     BatchStockMovement[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Stok bahan baku, penerimaan, dan saldo awal (README 5.2 dan 5.4)
// ---------------------------------------------------------------------------

/// Jenis pergerakan stok bahan baku. Nilai tambahan (penyesuaian,
/// penjualan/pembatalan) ditambahkan pada tugas roadmap berikutnya.
enum StockMovementType {
  RECEIPT
  OPENING_BALANCE
  /// Pemakaian aktual bahan pada produksi (README 5.2); mengurangi stok.
  PRODUCTION_USAGE
}

/// Saldo stok bahan baku per jenis bahan (README 5.2: stok dihitung sebagai
/// total per jenis bahan baku, bukan per penerimaan).
model MaterialStock {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String   @unique
  /// Selalu >= 0; setiap perubahan dicatat di MaterialStockMovement.
  quantity   Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("material_stocks")
}

/// Jejak setiap pergerakan stok (README 5.4). Setiap pergerakan dikaitkan
/// dengan catatan sumbernya (penerimaan atau saldo awal).
model MaterialStockMovement {
  id         String              @id @default(cuid())
  material   Material            @relation(fields: [materialId], references: [id])
  materialId String
  type       StockMovementType
  /// Jumlah selalu positif; arah pergerakan ditentukan oleh jenisnya.
  /// Pada B4 semua jenis menambah stok; pemakaian/penyesuaian menyusul.
  quantity   Decimal             @db.Decimal(14, 3)
  /// Tanggal bisnis (tanggal penerimaan atau tanggal saldo awal).
  occurredAt DateTime
  /// Waktu pencatatan disimpan terpisah dari tanggal bisnis.
  recordedAt DateTime            @default(now())
  recordedBy User                @relation(fields: [recordedById], references: [id])
  recordedById String
  /// Alasan; wajib diisi untuk saldo awal.
  reason     String?
  receipt    MaterialReceipt?    @relation(fields: [receiptId], references: [id])
  receiptId  String?             @unique
  openingBalance   MaterialOpeningBalance? @relation(fields: [openingBalanceId], references: [id])
  openingBalanceId String?                @unique
  /// Pemakaian produksi (B5): pergerakan dikaitkan dengan catatan sumbernya.
  productionUsage  ProductionMaterialUsage? @relation(fields: [productionUsageId], references: [id])
  productionUsageId String?                 @unique

  @@index([materialId])
  @@map("material_stock_movements")
}

/// Catatan penerimaan bahan baku (riwayat tetap tersimpan, tidak diedit/dihapus).
model MaterialReceipt {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  /// Tanggal penerimaan (tanggal bisnis).
  receivedAt DateTime
  note       String?
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt  DateTime @default(now())
  movement   MaterialStockMovement?

  @@index([materialId])
  @@map("material_receipts")
}

/// Saldo awal bahan baku (README 5.2): dicatat Admin secara terpisah dari
/// penerimaan biasa; wajib memuat tanggal, alasan, dan pengguna pencatat.
model MaterialOpeningBalance {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  /// Tanggal saldo awal (tanggal bisnis).
  date       DateTime
  reason     String
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt  DateTime @default(now())
  movement   MaterialStockMovement?

  @@index([materialId])
  @@map("material_opening_balances")
}

/// Kunci idempotensi (README 5.4 dan 6): mencegah permintaan berulang
/// menambah stok dua kali. Kunci disimpan dalam transaksi yang sama
/// dengan perubahan stok; permintaan ulang menerima respons tersimpan.
model IdempotencyKey {
  key            String
  endpoint       String
  userId         String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@id([key, endpoint, userId])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Produksi dan kode batch (README 5.3 dan 5.4)
// ---------------------------------------------------------------------------

/// Satu catatan produksi berarti produksi telah SELESAI (README 5.3).
/// Setelah tersimpan atomik: stok bahan berkurang sesuai pemakaian aktual
/// dan stok produk jadi batch bertambah sesuai jumlah hasil.
model Production {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  /// Tanggal produksi SEBENARNYA (bukan tanggal pencatatan); tidak boleh
  /// masa depan; pencatatan mundur diperbolehkan (README 5.3).
  productionDate DateTime
  /// Jumlah hasil produksi (satuan dasar produk).
  yieldQuantity   Decimal  @db.Decimal(14, 3)
  note            String?
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  recordedById    String
  /// Waktu pencatatan disimpan terpisah dari tanggal produksi (README 5.3).
  recordedAt      DateTime @default(now())
  batch           Batch?   @relation(fields: [batchId], references: [id])
  batchId         String?  @unique
  usages          ProductionMaterialUsage[]
  corrections     ProductionCorrection[]
  movements       BatchStockMovement[]

  @@index([productId])
  @@map("productions")
}

/// Pemakaian AKTUAL bahan baku pada suatu produksi (README 5.2: dicatat
/// manual berdasarkan jumlah aktual, tidak dihitung otomatis dari resep
/// dan tidak dialokasikan ke penerimaan tertentu).
model ProductionMaterialUsage {
  id           String      @id @default(cuid())
  production   Production  @relation(fields: [productionId], references: [id])
  productionId String
  material     Material    @relation(fields: [materialId], references: [id])
  materialId   String
  quantity     Decimal     @db.Decimal(14, 3)
  createdAt    DateTime    @default(now())
  movement     MaterialStockMovement?

  @@unique([productionId, materialId])
  @@index([materialId])
  @@map("productions_material_usage")
}

/// Batch produk jadi. Kode batch unik dijamin constraint UNIQUE database
/// (README 6), termasuk untuk penyimpanan bersamaan dan pencatatan mundur.
model Batch {
  id    String  @id @default(cuid())
  /// Kode aktif saat ini: NL-YYYYMMDD-NNN (README 5.3).
  code  String  @unique
  product Product @relation(fields: [productId], references: [id])
  productId String
  /// Tanggal produksi sesuai kode batch.
  productionDate DateTime
  /// Stok batch; dimulai dari jumlah hasil produksi (B5), berkurang saat
  /// penjualan (B7). Selalu >= 0; setiap perubahan dicatat di BatchStockMovement.
  stockQuantity  Decimal @default(0) @db.Decimal(14, 3)
  production     Production?
  aliases        BatchAlias[]
  stockMovements BatchStockMovement[]
  createdAt      DateTime @default(now())

  @@index([productId])
  @@map("batches")
}

/// Alias kode batch lama ketika tanggal produksi dikoreksi (README 5.3):
/// QR atau label lama tetap mengarah ke batch yang sama.
model BatchAlias {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String
  code      String   @unique
  createdAt DateTime @default(now())

  @@index([batchId])
  @@map("batch_aliases")
}

/// Jejak audit koreksi catatan produksi oleh Admin (README 5.3).
/// Riwayat pergerakan stok tidak pernah diedit — koreksi menambah
/// catatan pergerakan dan koreksi baru.
model ProductionCorrection {
  id            String     @id @default(cuid())
  production    Production @relation(fields: [productionId], references: [id])
  productionId  String
  changedBy     User       @relation(fields: [changedById], references: [id])
  changedById   String
  changedAt     DateTime   @default(now())
  /// 'productionDate' | 'yieldQuantity' | 'batchCode'
  field         String
  previousValue String
  newValue      String

  @@index([productionId])
  @@map("production_corrections")
}

/// Jenis pergerakan stok produk jadi per batch (README 5.4).
/// Nilai tambahan (penyesuaian stok, penjualan, pembatalan) ditambahkan
/// pada tugas roadmap berikutnya.
enum BatchMovementType {
  /// Hasil produksi menambah stok batch.
  PRODUCTION_YIELD
  /// Koreksi jumlah hasil oleh Admin; quantity bernilai tanda.
  YIELD_CORRECTION
}

/// Jejak setiap pergerakan stok produk jadi per batch (README 5.4).
/// Terpisah dari ledger bahan baku (MaterialStockMovement).
model BatchStockMovement {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String
  type      BatchMovementType
  /// Nilai TANDA: positif menambah stok batch, negatif mengurangi.
  quantity  Decimal  @db.Decimal(14, 3)
  /// Tanggal bisnis pergerakan.
  occurredAt DateTime
  /// Waktu pencatatan disimpan terpisah dari tanggal bisnis.
  recordedAt DateTime @default(now())
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  reason    String?
  /// Pergerakan dikaitkan dengan catatan sumbernya (README 5.4).
  production Production? @relation(fields: [productionId], references: [id])
  productionId String?

  @@index([batchId])
  @@map("batch_stock_movements")
}

/// Master produk (README 5.1). Setiap produk memiliki SATU satuan dasar;
/// produksi, stok, dan penjualan memakai satuan yang sama —
/// tidak ada konversi satuan otomatis.
model Product {
  id          String   @id @default(cuid())
  name        String
  /// Deskripsi produk untuk keperluan katalog (divalidasi & diterbitkan Admin pada tahap B8).
  description String?
  /// Satuan dasar produk (mis. "pcs", "botol", "kg").
  unit        String
  /// Harga jual per satuan dasar; ditetapkan di master dan dipakai
  /// otomatis saat penjualan (README 5.5).
  sellingPrice Decimal @db.Decimal(14, 2)
  /// Produk nonaktif tidak tersedia untuk produksi atau penjualan baru
  /// dan tidak muncul di katalog aktif. Riwayat yang tersimpan tetap utuh.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     Batch[]
  productions Production[]

  @@map("products")
}

/// Master bahan baku (README 5.1). Setiap bahan baku memiliki SATU satuan
/// dasar; penerimaan dan pemakaian memakai satuan yang sama —
/// tidak ada konversi satuan otomatis.
model Material {
  id        String   @id @default(cuid())
  name      String
  /// Satuan dasar bahan baku (mis. "kg", "liter", "sachet").
  unit      String
  /// Bahan baku nonaktif tidak dipakai untuk pencatatan baru; riwayat
  /// penerimaan/pemakaian yang tersimpan tetap utuh.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock            MaterialStock?
  receipts         MaterialReceipt[]
  openingBalances  MaterialOpeningBalance[]
  stockMovements   MaterialStockMovement[]
  productionUsages ProductionMaterialUsage[]

  @@map("materials")
}
