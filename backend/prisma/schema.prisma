// Skema database NutriLokal Smart Production & Traceability Kit V1.0.
//
// Tugas B1 menyiapkan fondasi koneksi. Tugas B2 menambahkan model
// pengguna untuk autentikasi dan hak akses. Tugas B3 menambahkan
// master produk dan master bahan baku. Tugas B4 menambahkan stok
// bahan baku, penerimaan, saldo awal, dan jejak pergerakan stok.
// Tugas B5 menambahkan produksi, kode batch, pemakaian bahan aktual,
// dan koreksi catatan produksi. Tugas B6 menambahkan stok awal produk
// jadi per batch dan penyesuaian stok oleh Admin. Tugas B7 menambahkan
// transaksi penjualan beserta alokasi batch dan pembatalan oleh Admin.
// Tugas B8 menambahkan kolom info publik produk (komposisi & petunjuk
// penyimpanan) serta status validasi/penerbitan/penarikan QR per batch.
// Model lainnya ditambahkan pada tugas roadmap berikutnya sesuai README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Peran pengguna internal. Hak akses selalu diperiksa di backend.
enum Role {
  ADMIN
  OPERATOR
}

/// Akun pengguna internal. Tidak ada pendaftaran publik;
/// akun Admin pertama dibuat melalui skrip bootstrap (npm run admin:create).
model User {
  id                String    @id @default(cuid())
  username          String    @unique
  /// Nama tampilan, boleh kosong.
  name              String?
  /// Kata sandi selalu disimpan sebagai hash (bcrypt), bukan teks biasa.
  passwordHash      String
  role              Role
  /// Akun dinonaktifkan tidak bisa login dan token lama ditolak.
  isActive          Boolean   @default(true)
  /// Setelah Admin mereset kata sandi, pengguna wajib menetapkan
  /// kata sandi baru sebelum bisa menggunakan sistem kembali.
  mustChangePassword Boolean  @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  materialReceipts        MaterialReceipt[]
  materialOpeningBalances MaterialOpeningBalance[]
  materialStockMovements  MaterialStockMovement[]
  productions             Production[]
  productionCorrections   ProductionCorrection[]
  batchStockMovements     BatchStockMovement[]
  batchOpeningBalances    BatchOpeningBalance[]
  stockAdjustments        StockAdjustment[]
  saleTransactions        SaleTransaction[] @relation("SaleRecordedBy")
  saleCancellations       SaleTransaction[] @relation("SaleCancelledBy")
  qrValidations           QrPublication[]   @relation("QrValidatedBy")
  qrPublications          QrPublication[]   @relation("QrPublishedBy")
  qrWithdrawals           QrPublication[]   @relation("QrWithdrawnBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Stok bahan baku, penerimaan, dan saldo awal (README 5.2 dan 5.4)
// ---------------------------------------------------------------------------

/// Jenis pergerakan stok bahan baku. Nilai tambahan (penjualan/
/// pembatalan) ditambahkan pada tugas roadmap berikutnya.
enum StockMovementType {
  RECEIPT
  OPENING_BALANCE
  /// Pemakaian aktual bahan pada produksi (README 5.2); mengurangi stok.
  PRODUCTION_USAGE
  /// Penyesuaian stok oleh Admin (README 5.4); quantity bernilai tanda.
  ADJUSTMENT
}

/// Saldo stok bahan baku per jenis bahan (README 5.2: stok dihitung sebagai
/// total per jenis bahan baku, bukan per penerimaan).
model MaterialStock {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String   @unique
  /// Selalu >= 0; setiap perubahan dicatat di MaterialStockMovement.
  quantity   Decimal  @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("material_stocks")
}

/// Jejak setiap pergerakan stok (README 5.4). Setiap pergerakan dikaitkan
/// dengan catatan sumbernya (penerimaan atau saldo awal).
model MaterialStockMovement {
  id         String              @id @default(cuid())
  material   Material            @relation(fields: [materialId], references: [id])
  materialId String
  type       StockMovementType
  /// Nilai selalu positif kecuali penyesuaian (ADJUSTMENT) yang bernilai
  /// tanda: positif menambah stok, negatif mengurangi.
  quantity   Decimal             @db.Decimal(14, 3)
  /// Tanggal bisnis (tanggal penerimaan atau tanggal saldo awal).
  occurredAt DateTime
  /// Waktu pencatatan disimpan terpisah dari tanggal bisnis.
  recordedAt DateTime            @default(now())
  recordedBy User                @relation(fields: [recordedById], references: [id])
  recordedById String
  /// Alasan; wajib diisi untuk saldo awal.
  reason     String?
  receipt    MaterialReceipt?    @relation(fields: [receiptId], references: [id])
  receiptId  String?             @unique
  openingBalance   MaterialOpeningBalance? @relation(fields: [openingBalanceId], references: [id])
  openingBalanceId String?                @unique
  /// Pemakaian produksi (B5): pergerakan dikaitkan dengan catatan sumbernya.
  productionUsage  ProductionMaterialUsage? @relation(fields: [productionUsageId], references: [id])
  productionUsageId String?                 @unique
  /// Penyesuaian stok (B6): pergerakan dikaitkan dengan catatan sumbernya.
  adjustment   StockAdjustment? @relation(fields: [adjustmentId], references: [id])
  adjustmentId String?          @unique

  @@index([materialId])
  @@map("material_stock_movements")
}

/// Catatan penerimaan bahan baku (riwayat tetap tersimpan, tidak diedit/dihapus).
model MaterialReceipt {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  /// Tanggal penerimaan (tanggal bisnis).
  receivedAt DateTime
  note       String?
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt  DateTime @default(now())
  movement   MaterialStockMovement?

  @@index([materialId])
  @@map("material_receipts")
}

/// Saldo awal bahan baku (README 5.2): dicatat Admin secara terpisah dari
/// penerimaan biasa; wajib memuat tanggal, alasan, dan pengguna pencatat.
model MaterialOpeningBalance {
  id         String   @id @default(cuid())
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  quantity   Decimal  @db.Decimal(14, 3)
  /// Tanggal saldo awal (tanggal bisnis).
  date       DateTime
  reason     String
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt  DateTime @default(now())
  movement   MaterialStockMovement?

  @@index([materialId])
  @@map("material_opening_balances")
}

/// Kunci idempotensi (README 5.4 dan 6): mencegah permintaan berulang
/// menambah stok dua kali. Kunci disimpan dalam transaksi yang sama
/// dengan perubahan stok; permintaan ulang menerima respons tersimpan.
model IdempotencyKey {
  key            String
  endpoint       String
  userId         String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  @@id([key, endpoint, userId])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Produksi dan kode batch (README 5.3 dan 5.4)
// ---------------------------------------------------------------------------

/// Satu catatan produksi berarti produksi telah SELESAI (README 5.3).
/// Setelah tersimpan atomik: stok bahan berkurang sesuai pemakaian aktual
/// dan stok produk jadi batch bertambah sesuai jumlah hasil.
model Production {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  /// Tanggal produksi SEBENARNYA (bukan tanggal pencatatan); tidak boleh
  /// masa depan; pencatatan mundur diperbolehkan (README 5.3).
  productionDate DateTime
  /// Jumlah hasil produksi (satuan dasar produk).
  yieldQuantity   Decimal  @db.Decimal(14, 3)
  note            String?
  recordedBy      User     @relation(fields: [recordedById], references: [id])
  recordedById    String
  /// Waktu pencatatan disimpan terpisah dari tanggal produksi (README 5.3).
  recordedAt      DateTime @default(now())
  batch           Batch?   @relation(fields: [batchId], references: [id])
  batchId         String?  @unique
  usages          ProductionMaterialUsage[]
  corrections     ProductionCorrection[]
  movements       BatchStockMovement[]

  @@index([productId])
  @@map("productions")
}

/// Pemakaian AKTUAL bahan baku pada suatu produksi (README 5.2: dicatat
/// manual berdasarkan jumlah aktual, tidak dihitung otomatis dari resep
/// dan tidak dialokasikan ke penerimaan tertentu).
model ProductionMaterialUsage {
  id           String      @id @default(cuid())
  production   Production  @relation(fields: [productionId], references: [id])
  productionId String
  material     Material    @relation(fields: [materialId], references: [id])
  materialId   String
  quantity     Decimal     @db.Decimal(14, 3)
  createdAt    DateTime    @default(now())
  movement     MaterialStockMovement?

  @@unique([productionId, materialId])
  @@index([materialId])
  @@map("productions_material_usage")
}

/// Batch produk jadi. Kode batch unik dijamin constraint UNIQUE database
/// (README 6), termasuk untuk penyimpanan bersamaan dan pencatatan mundur.
model Batch {
  id    String  @id @default(cuid())
  /// Kode aktif saat ini: NL-YYYYMMDD-NNN, atau NL-OPEN-YYYYMMDD-NNN
  /// untuk stok awal tanpa tanggal produksi yang diketahui (README 5.3).
  code  String  @unique
  product Product @relation(fields: [productId], references: [id])
  productId String
  /// Tanggal produksi sesuai kode batch. KOSONG untuk batch stok awal
  /// yang tidak diketahui tanggal produksinya (README 5.3).
  productionDate DateTime?
  /// Stok batch; dimulai dari jumlah hasil produksi (B5) atau stok awal
  /// (B6), berkurang saat penjualan (B7). Selalu >= 0; setiap perubahan
  /// dicatat di BatchStockMovement.
  stockQuantity  Decimal @default(0) @db.Decimal(14, 3)
  /// Tanggal kedaluwarsa (README 5.6): BOLEH KOSONG bila belum tersedia
  /// atau belum divalidasi. Tidak boleh dikarang.
  expiryDate     DateTime?
  /// Waktu Admin mencatat sekaligus memvalidasi tanggal kedaluwarsa;
  /// null = belum divalidasi. Penjualan dari batch yang tanggalnya sudah
  /// lewat hanya ditolak setelah keduanya tersedia (README 5.5).
  expiryValidatedAt DateTime?
  production     Production?
  openingBalance BatchOpeningBalance?
  aliases        BatchAlias[]
  stockMovements BatchStockMovement[]
  stockAdjustments StockAdjustment[]
  saleAllocations SaleAllocation[]
  /// Status QR traceability batch (README 5.6): satu baris per batch —
  /// siklus validasi → penerbitan → (penarikan) oleh Admin.
  qrPublication QrPublication?
  createdAt      DateTime @default(now())

  @@index([productId])
  @@map("batches")
}

/// Alias kode batch lama ketika tanggal produksi dikoreksi (README 5.3):
/// QR atau label lama tetap mengarah ke batch yang sama.
model BatchAlias {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String
  code      String   @unique
  createdAt DateTime @default(now())

  @@index([batchId])
  @@map("batch_aliases")
}

/// Jejak audit koreksi catatan produksi oleh Admin (README 5.3).
/// Riwayat pergerakan stok tidak pernah diedit — koreksi menambah
/// catatan pergerakan dan koreksi baru.
model ProductionCorrection {
  id            String     @id @default(cuid())
  production    Production @relation(fields: [productionId], references: [id])
  productionId  String
  changedBy     User       @relation(fields: [changedById], references: [id])
  changedById   String
  changedAt     DateTime   @default(now())
  /// 'productionDate' | 'yieldQuantity' | 'batchCode'
  field         String
  previousValue String
  newValue      String

  @@index([productionId])
  @@map("production_corrections")
}

/// Jenis pergerakan stok produk jadi per batch (README 5.4).
enum BatchMovementType {
  /// Hasil produksi menambah stok batch.
  PRODUCTION_YIELD
  /// Koreksi jumlah hasil oleh Admin; quantity bernilai tanda.
  YIELD_CORRECTION
  /// Stok awal produk jadi per batch (README 5.3); menambah stok.
  OPENING_BALANCE
  /// Penyesuaian stok oleh Admin (README 5.4); quantity bernilai tanda.
  ADJUSTMENT
  /// Penjualan mengurangi stok batch sesuai alokasi (README 5.5);
  /// quantity bernilai tanda (negatif).
  SALE
  /// Pengembalian stok ke batch asal saat transaksi dibatalkan
  /// (README 5.5); quantity positif.
  SALE_CANCELLATION
}

/// Jejak setiap pergerakan stok produk jadi per batch (README 5.4).
/// Terpisah dari ledger bahan baku (MaterialStockMovement).
model BatchStockMovement {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String
  type      BatchMovementType
  /// Nilai TANDA: positif menambah stok batch, negatif mengurangi.
  quantity  Decimal  @db.Decimal(14, 3)
  /// Tanggal bisnis pergerakan.
  occurredAt DateTime
  /// Waktu pencatatan disimpan terpisah dari tanggal bisnis.
  recordedAt DateTime @default(now())
  recordedBy User     @relation(fields: [recordedById], references: [id])
  recordedById String
  reason    String?
  /// Pergerakan dikaitkan dengan catatan sumbernya (README 5.4).
  production Production? @relation(fields: [productionId], references: [id])
  productionId String?
  /// Stok awal batch (B6): pergerakan dikaitkan dengan catatan sumbernya.
  openingBalance  BatchOpeningBalance? @relation(fields: [openingBalanceId], references: [id])
  openingBalanceId String?              @unique
  /// Penyesuaian stok (B6): pergerakan dikaitkan dengan catatan sumbernya.
  adjustment   StockAdjustment? @relation(fields: [adjustmentId], references: [id])
  adjustmentId String?          @unique
  /// Alokasi penjualan (B7): pergerakan PENJUALAN dan PENGEMBALIAN stok
  /// dikaitkan dengan catatan sumbernya (alokasi item transaksi). Satu
  /// alokasi dapat memiliki dua pergerakan: SALE lalu SALE_CANCELLATION.
  saleAllocation  SaleAllocation? @relation(fields: [saleAllocationId], references: [id])
  saleAllocationId String?

  @@index([batchId])
  @@index([saleAllocationId])
  @@map("batch_stock_movements")
}

// ---------------------------------------------------------------------------
// Stok awal produk jadi dan penyesuaian stok (README 5.3 dan 5.4)
// ---------------------------------------------------------------------------

/// Stok awal produk jadi per batch (README 5.3): dicatat Admin; hanya
/// informasi yang benar-benar diketahui boleh dicatat. Riwayat catatan
/// tidak pernah diedit atau dihapus.
model BatchOpeningBalance {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String   @unique
  quantity  Decimal  @db.Decimal(14, 3)
  /// Catatan opsional (komposisi, tanggal kedaluwarsa, dsb. dicatat di
  /// modulnya masing-masing — jangan dikarang di sini).
  note      String?
  recordedBy User    @relation(fields: [recordedById], references: [id])
  recordedById String
  createdAt DateTime @default(now())
  movement  BatchStockMovement?

  @@map("batch_opening_balances")
}

/// Sasaran penyesuaian stok (README 5.4): bahan baku atau suatu batch.
enum StockAdjustmentTargetType {
  MATERIAL
  BATCH
}

/// Penyesuaian stok oleh Admin melalui fungsi khusus (README 5.4).
/// Nilai positif menambah stok, negatif mengurangi. Alasan, waktu, dan
/// pengguna wajib tercatat. Catatan tidak pernah diedit atau dihapus.
model StockAdjustment {
  id         String   @id @default(cuid())
  targetType StockAdjustmentTargetType
  material   Material? @relation(fields: [materialId], references: [id])
  materialId String?
  batch      Batch?    @relation(fields: [batchId], references: [id])
  batchId    String?
  /// Nilai TANDA: positif menambah stok, negatif mengurangi.
  quantity   Decimal  @db.Decimal(14, 3)
  reason     String
  adjustedBy User     @relation(fields: [adjustedById], references: [id])
  adjustedById String
  adjustedAt DateTime @default(now())
  /// Pergerakan stok terkait (dikaitkan dua arah dengan catatan sumber).
  materialMovement MaterialStockMovement?
  batchMovement    BatchStockMovement?

  @@index([materialId])
  @@index([batchId])
  @@map("stock_adjustments")
}

// ---------------------------------------------------------------------------
// Penjualan dan pembatalan transaksi (README 5.5)
// ---------------------------------------------------------------------------

/// Satu transaksi penjualan (README 5.5). Total DIHITUNG BACKEND dari
/// harga satuan master produk × jumlah item — bukan dari input klien.
/// Transaksi tersimpan tidak pernah diedit atau dihapus; Admin hanya
/// dapat membatalkannya dengan alasan, dan stok dikembalikan ke batch
/// asal. Transaksi batal tidak masuk omzet (dicek lewat cancelledAt).
model SaleTransaction {
  id           String   @id @default(cuid())
  /// Total transaksi (jumlah seluruh baris item, dibulatkan 2 desimal).
  total        Decimal  @db.Decimal(14, 2)
  recordedBy   User     @relation("SaleRecordedBy", fields: [recordedById], references: [id])
  recordedById String
  /// Waktu pencatatan transaksi.
  recordedAt   DateTime @default(now())
  /// Alasan pembatalan oleh Admin; wajib diisi bila dibatalkan.
  cancelReason String?
  cancelledAt  DateTime?
  cancelledBy  User?    @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cancelledById String?
  items        SaleItem[]

  @@index([recordedById])
  @@index([cancelledById])
  @@map("sale_transactions")
}

/// Item penjualan per jenis produk (satu produk maksimal satu item per
/// transaksi). Harga satuan disimpan dari master pada saat transaksi
/// sehingga perubahan harga produk tidak mengubah transaksi lama.
model SaleItem {
  id            String          @id @default(cuid())
  transaction   SaleTransaction @relation(fields: [transactionId], references: [id])
  transactionId String
  product       Product         @relation(fields: [productId], references: [id])
  productId     String
  /// Jumlah terjual (satuan dasar produk) = jumlah seluruh alokasi item.
  quantity      Decimal         @db.Decimal(14, 3)
  /// Harga satuan dari master produk pada saat transaksi (README 5.5).
  unitPrice     Decimal         @db.Decimal(14, 2)
  allocations   SaleAllocation[]

  @@unique([transactionId, productId])
  @@index([productId])
  @@map("sale_items")
}

/// Alokasi batch per item penjualan (README 5.5): Operator memilih batch
/// yang benar-benar diambil; satu item dapat dialokasikan ke beberapa
/// batch. Riwayat alokasi tetap ada walaupun transaksi dibatalkan.
model SaleAllocation {
  id       String   @id @default(cuid())
  item     SaleItem @relation(fields: [itemId], references: [id])
  itemId   String
  batch    Batch    @relation(fields: [batchId], references: [id])
  batchId  String
  /// Jumlah yang diambil dari batch ini (satuan dasar produk).
  quantity Decimal  @db.Decimal(14, 3)
  movements BatchStockMovement[]

  @@unique([itemId, batchId])
  @@index([batchId])
  @@map("sale_allocations")
}

// ---------------------------------------------------------------------------
// Katalog publik dan QR traceability (README 5.6)
// ---------------------------------------------------------------------------

/// Status publikasi QR per batch (README 5.6). Setiap batch memiliki QR
/// unik (kode batch + alias); isi informasi publiknya berasal dari master
/// produk (nama, deskripsi, komposisi, petunjuk penyimpanan) dan fakta
/// batch (kode, tanggal produksi, tanggal kedaluwarsa tervalidasi).
/// Baris ini HANYA menyimpan siklus Admin: memvalidasi, menerbitkan,
/// dan menarik. Jika ditarik, QR menampilkan pemberitahuan bahwa
/// informasi publik tidak tersedia — tanpa data yang ditarik/internal.
model QrPublication {
  id       String @id @default(cuid())
  batch    Batch  @relation(fields: [batchId], references: [id])
  batchId  String @unique
  /// Waktu Admin memvalidasi isi informasi publik; null = belum divalidasi.
  validatedAt   DateTime?
  validatedBy   User?  @relation("QrValidatedBy", fields: [validatedById], references: [id])
  validatedById String?
  /// Waktu informasi diterbitkan ke publik (QR aktif menampilkan data).
  publishedAt   DateTime?
  publishedBy   User?  @relation("QrPublishedBy", fields: [publishedById], references: [id])
  publishedById String?
  /// Waktu Admin menarik informasi publik (QR menampilkan pemberitahuan).
  withdrawnAt   DateTime?
  withdrawnBy   User?  @relation("QrWithdrawnBy", fields: [withdrawnById], references: [id])
  withdrawnById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([validatedById])
  @@index([publishedById])
  @@index([withdrawnById])
  @@map("qr_publications")
}

/// Master produk (README 5.1). Setiap produk memiliki SATU satuan dasar;
/// produksi, stok, dan penjualan memakai satuan yang sama —
/// tidak ada konversi satuan otomatis.
model Product {
  id          String   @id @default(cuid())
  name        String
  /// Deskripsi produk untuk keperluan katalog & QR (dikelola Admin).
  description String?
  /// Komposisi bahan untuk QR traceability (README 5.6): teks yang
  /// dimasukkan Admin dari resep nyata — tidak dikarang sistem.
  composition String?
  /// Petunjuk penyimpanan untuk QR traceability (README 5.6).
  storageInstructions String?
  /// Satuan dasar produk (mis. "pcs", "botol", "kg").
  unit        String
  /// Harga jual per satuan dasar; ditetapkan di master dan dipakai
  /// otomatis saat penjualan (README 5.5).
  sellingPrice Decimal @db.Decimal(14, 2)
  /// Produk nonaktif tidak tersedia untuk produksi atau penjualan baru
  /// dan tidak muncul di katalog aktif. Riwayat yang tersimpan tetap utuh.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     Batch[]
  productions Production[]
  saleItems   SaleItem[]

  @@map("products")
}

/// Master bahan baku (README 5.1). Setiap bahan baku memiliki SATU satuan
/// dasar; penerimaan dan pemakaian memakai satuan yang sama —
/// tidak ada konversi satuan otomatis.
model Material {
  id        String   @id @default(cuid())
  name      String
  /// Satuan dasar bahan baku (mis. "kg", "liter", "sachet").
  unit      String
  /// Bahan baku nonaktif tidak dipakai untuk pencatatan baru; riwayat
  /// penerimaan/pemakaian yang tersimpan tetap utuh.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock            MaterialStock?
  receipts         MaterialReceipt[]
  openingBalances  MaterialOpeningBalance[]
  stockMovements   MaterialStockMovement[]
  productionUsages ProductionMaterialUsage[]
  stockAdjustments StockAdjustment[]

  @@map("materials")
}
