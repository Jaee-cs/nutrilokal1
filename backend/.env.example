# Salin file ini menjadi .env lalu isi sesuai kebutuhan lingkungan Anda.
# Jangan pernah menaruh nilai rahasia sungguhan di .env.example atau di source code.

# Koneksi database PostgreSQL (dipakai aplikasi dan Prisma)
# Port host untuk container PostgreSQL (5432 dipakai container proyek lain)
DATABASE_URL="postgresql://nutrilokal:nutrilokal_dev@localhost:5434/nutrilokal"

# Port server backend
PORT=3000

# Direktori penyimpanan foto produk (unggahan berkas, disajikan di /api/uploads).
# Kosongkan untuk memakai default `backend/uploads`.
# Di deployment, arahkan ke direktori/volume PERSISTEN dan ikutkan isinya
# dalam jadwal pencadangan (backup) bersama database.
# UPLOADS_DIR=/var/lib/nutrilokal/uploads

# Rahasia untuk menandatangani token JWT.
# Buat nilai acak baru (jangan pakai nilai contoh): openssl rand -hex 32
JWT_SECRET=ganti_dengan_nilai_acak_panjang_minimal_32_karakter

# Origin frontend yang diizinkan memanggil API lintas domain (CORS).
# Pisahkan dengan koma bila lebih dari satu. Kosongkan bila frontend dan
# backend satu origin (mis. saat pengembangan lewat proxy Vite).
# Contoh: FRONTEND_ORIGIN="https://nutrilokal.onrender.com,http://localhost:5173"
FRONTEND_ORIGIN=

# Akun Admin pertama dibuat lewat skrip bootstrap, bukan dari kode:
#   1. Isi ADMIN_USERNAME dan ADMIN_PASSWORD di bawah (hanya untuk pembuatan).
#   2. Jalankan: npm run admin:create
#   3. Setelah akun Admin pertama dibuat, hapus ADMIN_PASSWORD dari file ini.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Nilai untuk docker-compose (harus konsisten dengan DATABASE_URL di atas)
POSTGRES_USER=nutrilokal
POSTGRES_PASSWORD=nutrilokal_dev
POSTGRES_DB=nutrilokal
POSTGRES_PORT=5434