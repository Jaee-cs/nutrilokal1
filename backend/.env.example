# Salin file ini menjadi .env lalu isi sesuai kebutuhan lingkungan Anda.
# Jangan pernah menaruh nilai rahasia sungguhan di .env.example atau di source code.

# Koneksi database PostgreSQL (dipakai aplikasi dan Prisma)
# Port host untuk container PostgreSQL (5432 dipakai container proyek lain)
DATABASE_URL="postgresql://nutrilokal:nutrilokal_dev@localhost:5434/nutrilokal"

# Port server backend
PORT=3000

# Nilai untuk docker-compose (harus konsisten dengan DATABASE_URL di atas)
POSTGRES_USER=nutrilokal
POSTGRES_PASSWORD=nutrilokal_dev
POSTGRES_DB=nutrilokal
POSTGRES_PORT=5434